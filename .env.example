# Nebius Token Factory & Sandboxes
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
SHIPCHECK_PROBE_IMAGE_UUID=

# Nemotron Model Tier IDs (Case-sensitive - PRD Section 6)
NEMOTRON_ULTRA_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_SUPER_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_NANO_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_LIGHTNING_MODEL_ID=nvidia/Nemotron-3_5-Lightning

# Tavily API (Grounding & Research)
TAVILY_API_KEY=

# GitHub Bot (Least-privilege PAT with repo or Contents+Pull Requests: write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# Runtime & Sandbox Guards
SANDBOX_BACKEND=mock   # options: 'contree', 'docker', 'mock'
# 'docker': one container per sandbox from this image (see README)
SHIPCHECK_DOCKER_IMAGE=shipcheck-probe:latest
SHIPCHECK_DOCKER_PLATFORM=
LLM_BACKEND=mock       # options: 'nemotron', 'mock'
MAX_CONCURRENT_OPS=40
PROBE_TIMEOUT_SECONDS=45
OVERALL_SCAN_BUDGET_OPS=50
